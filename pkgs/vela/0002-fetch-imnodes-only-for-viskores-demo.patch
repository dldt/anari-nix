From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thomas Arcila <134677+tarcila@users.noreply.github.com>
Date: Sun, 31 Aug 2026 12:00:00 -0400
Subject: [PATCH] fix(external): fetch imnodes only for the Viskores demo

imnodes is consumed by the Viskores demo alone, but external/CMakeLists.txt
adds its subdirectory with the rest of the UI externals, so
anari_sdk_fetch_project() downloads the archive on every UI build -- including
ones that compile none of it. Gate the subdirectory on its one consumer, and declare
BUILD_VISKORES_DEMO with the other options so external/ (which is added before
src/) sees a defined variable rather than relying on the option's default.
---
 CMakeLists.txt                            | 1 +
 external/CMakeLists.txt                   | 5 ++++-
 src/apps/interactive/demos/CMakeLists.txt | 1 -
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 528eddb..0d63254 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -67,6 +67,7 @@ option(VSR_NANOVDB_SKIP_INVALID_VOLUMES
 option(VSR_NANOVDB_USE_ZIP
   "Enable zlib so NanoVDB importer can read ZIP-compressed .nvdb files" ON)
 option(VSR_USE_LUA "Enable Lua scripting support" ON)
+option(BUILD_VISKORES_DEMO "Build Viskores demo viewer" OFF)
 
 if (APPLE)
   set(VSR_USE_CUDA OFF)
diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index 9ae562c..0d818e7 100644
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -5,6 +5,5 @@
 add_subdirectory(vela_flip)
 add_subdirectory(vela_fmtlib)
-add_subdirectory(vela_imnodes)
 add_subdirectory(vela_imoguizmo)
 add_subdirectory(vela_mikktspace)
 add_subdirectory(vela_nanovdb)
@@ -15,5 +14,9 @@
 add_subdirectory(vela_zlib EXCLUDE_FROM_ALL)
 
+if(BUILD_VISKORES_DEMO)
+  add_subdirectory(vela_imnodes)
+endif()
+
 if(VSR_BUILD_UI_LIBRARY)
   add_subdirectory(vela_imgui_sdl)
   add_subdirectory(vela_imguizmo)
diff --git a/src/apps/interactive/demos/CMakeLists.txt b/src/apps/interactive/demos/CMakeLists.txt
index cb41b8c..011b780 100644
--- a/src/apps/interactive/demos/CMakeLists.txt
+++ b/src/apps/interactive/demos/CMakeLists.txt
@@ -6,7 +6,6 @@ add_subdirectory(animatedVolume)
 add_subdirectory(arrayInstancing)
 add_subdirectory(manualAccumulationReset)
 add_subdirectory(customField)
-option(BUILD_VISKORES_DEMO "Build Viskores demo viewer" OFF)
 if (BUILD_VISKORES_DEMO)
   add_subdirectory(viskores)
 endif()
-- 
