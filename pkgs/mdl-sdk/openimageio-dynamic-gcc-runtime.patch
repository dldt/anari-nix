diff --git a/src/shaders/plugin/openimageio/CMakeLists.txt b/src/shaders/plugin/openimageio/CMakeLists.txt
--- a/src/shaders/plugin/openimageio/CMakeLists.txt
+++ b/src/shaders/plugin/openimageio/CMakeLists.txt
@@ -53,6 +53,10 @@ create_from_base_preset(
     EMBED_RC "openimageio.rc"
     OUTPUT_NAME "nv_openimageio"
     EXPORTED_SYMBOLS mi_plugin_factory
+    # Shared OpenImageIO returns owning STL containers. Use the shared C++
+    # runtime for their destruction rather than a localized static delete,
