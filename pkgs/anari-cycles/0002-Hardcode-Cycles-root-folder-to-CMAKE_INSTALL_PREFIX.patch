From f6f328c46855480459c8dcf661332cd31ee1f1d3 Mon Sep 17 00:00:00 2001
From: Thomas Arcila <134677+tarcila@users.noreply.github.com>
Date: Thu, 1 May 2025 10:03:15 -0400
Subject: [PATCH] Hardcode Cycles root folder to CMAKE_INSTALL_PREFIX

Use the installed resources rather than paths relative to the host
application. Upstream now shares path_program_dir() between the resource
and user-path fallbacks.

Use const pointers for the compiled-in shader and source paths.
---
diff --git a/cycles/src/util/CMakeLists.txt b/cycles/src/util/CMakeLists.txt
--- a/cycles/src/util/CMakeLists.txt
+++ b/cycles/src/util/CMakeLists.txt
@@ -9,6 +9,10 @@
 set(INC_SYS
 )
 
+set_source_files_properties(
+  path.cpp
+  PROPERTIES COMPILE_DEFINITIONS "CMAKE_INSTALL_PREFIX=\"${CMAKE_INSTALL_PREFIX}\""
+)
 set(SRC
   aligned_malloc.cpp
   colorspace.cpp
diff --git a/cycles/src/util/path.cpp b/cycles/src/util/path.cpp
--- a/cycles/src/util/path.cpp
+++ b/cycles/src/util/path.cpp
@@ -304,11 +304,16 @@
 
 } /* namespace */
 
-static char *path_specials(const string &sub)
-{
+static const char *path_specials(const string &sub)
+{
+#ifdef CMAKE_INSTALL_PREFIX
+  static const char *const env_shader_path = CMAKE_INSTALL_PREFIX "/shader";
+  static const char *const env_source_path = CMAKE_INSTALL_PREFIX "/source";
+#else
   static char *const env_shader_path = getenv("CYCLES_SHADER_PATH");
   /* NOTE: It is KERNEL in env variable for compatibility reasons. */
   static char *const env_source_path = getenv("CYCLES_KERNEL_PATH");
+#endif
 
   if (env_shader_path != nullptr && sub == "shader") {
     return env_shader_path;
@@ -337,7 +342,11 @@
 /* Fallback for when #path_init was not called to initialize #cached_path. */
 static const string &path_program_dir()
 {
+#ifdef CMAKE_INSTALL_PREFIX
+  static const string program_dir = CMAKE_INSTALL_PREFIX;
+#else
   static const string program_dir = path_dirname(OIIO::Sysutil::this_program_path());
+#endif
   return program_dir;
 }
 
@@ -356,7 +365,7 @@
 
 string path_get(const string &sub)
 {
-  char *special = path_specials(sub);
+  const char *special = path_specials(sub);
   if (special != nullptr) {
     return special;
   }
