From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thomas Arcila <134677+tarcila@users.noreply.github.com>
Date: Tue, 6 Oct 2026 12:00:00 -0400
Subject: [PATCH] fix(bvh): read SIMD hit record lanes via memcpy in closest()

closest() read lanes of the SIMD hit record through int*/float* casts,
violating strict aliasing. GCC 15 at -O3 then loads stale stack data,
e.g. FLT_MAX as prim_id, and downstream attribute lookups segfault.
---
--- a/include/visionaray/detail/bvh/intersect_ray1_bvhN.inl
+++ b/include/visionaray/detail/bvh/intersect_ray1_bvhN.inl
@@ -4,6 +4,7 @@
 #pragma once
 
 #include <cstddef>
+#include <cstring>
 #include <type_traits>
 #include <utility>
 
@@ -227,15 +228,18 @@
 
     int closest_index = min_index(hr.t, hr.hit.i);
 
-    auto* prim_id = (int const*)&hr.prim_id;
-    auto* geom_id = (int const*)&hr.geom_id;
-    auto* inst_id = (int const*)&hr.inst_id;
-    auto* t = (float const*)&hr.t;
-    auto* isect_pos_x = (float const*)&hr.isect_pos.x;
-    auto* isect_pos_y = (float const*)&hr.isect_pos.y;
-    auto* isect_pos_z = (float const*)&hr.isect_pos.z;
-    auto* u = (float const*)&hr.u;
-    auto* v = (float const*)&hr.v;
+    constexpr int N = simd::num_elements<I>::value;
+    int prim_id[N], geom_id[N], inst_id[N];
+    float t[N], isect_pos_x[N], isect_pos_y[N], isect_pos_z[N], u[N], v[N];
+    std::memcpy(prim_id, &hr.prim_id, sizeof(prim_id));
+    std::memcpy(geom_id, &hr.geom_id, sizeof(geom_id));
+    std::memcpy(inst_id, &hr.inst_id, sizeof(inst_id));
+    std::memcpy(t, &hr.t, sizeof(t));
+    std::memcpy(isect_pos_x, &hr.isect_pos.x, sizeof(isect_pos_x));
+    std::memcpy(isect_pos_y, &hr.isect_pos.y, sizeof(isect_pos_y));
+    std::memcpy(isect_pos_z, &hr.isect_pos.z, sizeof(isect_pos_z));
+    std::memcpy(u, &hr.u, sizeof(u));
+    std::memcpy(v, &hr.v, sizeof(v));
 
     hit_record<R, primitive<unsigned>> result;
     result.hit = true;
