diff --git a/src/hdanari/CMakeLists.txt b/src/hdanari/CMakeLists.txt
index c28a0ac02b..bcfd7b87b8 100644
--- a/src/hdanari/CMakeLists.txt
+++ b/src/hdanari/CMakeLists.txt
@@ -14,6 +14,12 @@
 
 list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR}/cmake)
 
+# OpenSubdiv's exported targets (pulled in transitively by USD's pxrConfig)
+# reference the imported Threads::Threads target without declaring the
+# dependency. Older OpenSubdiv (shipped with USD < 26.05) fails to configure
+# unless Threads is found first.
+find_package(Threads REQUIRED)
+
 find_package(USD REQUIRED NAMES pxr)
 find_package(anari REQUIRED)
 if(LINUX)
diff --git a/src/hdanari/rd/renderSettings.cpp b/src/hdanari/rd/renderSettings.cpp
index 35788911c4..a8f27ffb4c 100644
--- a/src/hdanari/rd/renderSettings.cpp
+++ b/src/hdanari/rd/renderSettings.cpp
@@ -48,8 +48,15 @@
   if (!rs)
     return;
 
+#if PXR_VERSION >= 2511
+  // GetNamespacedSettings() returns an HdSampledDataSourceContainerSchema
+  // wrapper; unwrap it to the underlying container handle.
   const HdContainerDataSourceHandle settings =
       rs.GetNamespacedSettings().GetContainer();
+#else
+  // Older USD returns the container handle directly.
+  const HdContainerDataSourceHandle settings = rs.GetNamespacedSettings();
+#endif
   if (!settings)
     return;
 
